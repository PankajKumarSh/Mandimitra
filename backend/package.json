{
  "name": "@mandimitra/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "build": "node scripts/build.mjs",
    "start:prod": "node --enable-source-maps dist/server.js",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "worker:prod": "node --enable-source-maps dist/worker.js",
    "admin:grant": "tsx --env-file-if-exists=.env scripts/grant-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.11.0",
    "@aws-sdk/client-s3": "3.1173.0",
    "@mandimitra/database": "*",
    "@mandimitra/shared": "*",
    "@node-rs/argon2": "2.2.2",
    "@sentry/node": "11.15.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "playwright-core": "1.65.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "17.12.0-beta.19",
    "esbuild": "0.28.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}

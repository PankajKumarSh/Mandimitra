# Copy to database/.env and backend/.env (Phase 2) — never commit real values.

# --- Database ---
DATABASE_URL="postgresql://mandimitra:mandimitra_dev@localhost:5433/mandimitra?schema=public"

# --- Auth (Phase 2) ---
JWT_ACCESS_SECRET="change-me-64-random-bytes"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# 32-byte key, base64 — encrypts farmer bank account numbers
FIELD_ENCRYPTION_KEY=""

# --- App ---
NODE_ENV="development"
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
# Public URL; must be https:// in production (also enables HSTS on the web app)
APP_URL="http://localhost:3000"

# --- AI (Phase 6) — server-side only. Empty key = assistant disabled. ---
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"
AI_EFFORT="medium"
AI_MAX_TOOL_ROUNDS=6

# --- WhatsApp Cloud API: mock (dev) | cloud | disabled. Production refuses mock. ---
WHATSAPP_PROVIDER="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_GRAPH_VERSION="v23.0"

# --- Subscription billing: mock (dev test checkout) | razorpay. Production refuses mock. ---
BILLING_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
BILLING_PERIOD_DAYS=30
# A lapsed paid plan stays PAST_DUE (read-only) this long, then EXPIRED
BILLING_GRACE_DAYS=15

# --- File storage: local (dev / single server) | s3 (AWS S3, Cloudflare R2, MinIO…; bucket must be private) ---
STORAGE_DRIVER="local"
UPLOAD_DIR=".uploads"
# Leave S3_ENDPOINT empty for AWS; set it (and S3_FORCE_PATH_STYLE=true for MinIO) otherwise
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="mandimitra-dev"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=false

# --- Background jobs: inline (inside the API; dev / single server) | worker (separate process) | off ---
JOBS_MODE="inline"

# --- Error tracking (optional) ---
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
